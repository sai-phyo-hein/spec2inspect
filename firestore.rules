rules_version = '2';
// Browsers never talk to Firestore directly: the inspection log is written and read by spec-web (Cloud Run)
// through its service account, which these rules don't affect. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
