{
  "hosting": {
    "site": "spec2inspect",
    "public": "web/public",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "replay/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "spec-web",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/replay/**",
        "run": {
          "serviceId": "spec-web",
          "region": "asia-southeast1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}